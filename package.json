{
	"name": "@flowtag/next",
	"version": "0.0.0",
	"description": "Flowtag tracking adapter for Next.js",
	"main": "./dist/index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/useflowtag/next.git"
	},
	"homepage": "https://docs.flowtag.dev/sdk/analytics-next",
	"scripts": {
		"build": "tsdown src/index.tsx --format esm,cjs --dts --out-dir dist --clean",
		"test": "vitest run",
		"lint": "biome check src",
		"lint:pub": "publint",
		"fmt": "biome format src",
		"lint:ci": "biome ci",
		"typecheck": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"sideEffects": false,
	"keywords": [
		"flowtag",
		"analytics",
		"nextjs",
		"react",
		"sdk",
		"ftag"
	],
	"author": "Flowtag Team & Contributors",
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.1.1",
	"peerDependencies": {
		"next": ">=12.0.0",
		"react": ">=16.8.0",
		"react-dom": ">=16.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@semantic-release/npm": "^13.1.5",
		"@types/react": "^19.2.14",
		"publint": "^0.3.20",
		"semantic-release": "^25.0.3",
		"tsdown": "^0.22.0",
		"typescript": "^6.0.3"
	}
}
