{
	"compilerOptions": {
		"target": "es2016",
		"jsx": "react-jsx",
		"module": "esnext",
		"rootDir": "./src",
		"moduleResolution": "bundler",
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "./dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0"
	}
}
